{
  "name": "cahaya-malam",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "description": "Fourteen years of VIIRS DNB night lights over Indonesian cities, with the cloud-free observation count carried alongside every radiance value.",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm data:validate && next build",
    "preview": "node scripts/preview.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integrity": "vitest run tests/integrity",
    "test:flags": "vitest run tests/flags",
    "data:fetch": "tsx scripts/fetch-composites.ts",
    "data:build": "tsx scripts/build-data.ts",
    "data:validate": "tsx scripts/validate-data.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.3"
  }
}
